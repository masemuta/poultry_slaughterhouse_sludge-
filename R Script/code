cat("\n------------------------------------------------------------\n")
cat("2.5.1 Continuous sludge-dose variable\n")
cat("------------------------------------------------------------\n\n")

soybean_data <- soybean_data %>%
  mutate(
    Dose_t_ha = as.numeric(
