# ------------------------------------------------------------
# 2.5.2 Linear dose-response model
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.2 Linear dose-response model\n")
cat("------------------------------------------------------------\n\n")

model_linear <- lmer(
  Soja ~
    Year +
    Dose_t_ha +
    (1 | Plot),
  data = soybean_data,
  REML = FALSE
)

print(
  summary(model_linear)
)

# ------------------------------------------------------------
# 2.5.3 Quadratic dose-response model
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.3 Quadratic dose-response model\n")
cat("------------------------------------------------------------\n\n")

model_quadratic <- lmer(
  Soja ~
    Year +
    Dose_t_ha +
    I(Dose_t_ha^2) +
    (1 | Plot),
  data = soybean_data,
  REML = FALSE
)

print(
  summary(model_quadratic)
)

# ------------------------------------------------------------
# 2.5.4 Compare linear and quadratic models
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.4 Linear versus quadratic model comparison\n")
cat("------------------------------------------------------------\n\n")

model_linear_quadratic_comparison <- anova(
  model_linear,
  model_quadratic
)

print(
  model_linear_quadratic_comparison
)

cat("\nAIC comparison:\n")

print(
  AIC(
    model_linear,
    model_quadratic
  )
)

# ------------------------------------------------------------
# 2.5.5 Quadratic coefficient significance
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.5 Quadratic coefficient\n")
cat("------------------------------------------------------------\n\n")

quadratic_coefficient <- coef(
  summary(model_quadratic)
)$Plot

cat("Fixed-effect coefficients:\n")

print(
  fixef(model_quadratic)
)

cat("\nQuadratic coefficient from model summary:\n")

print(
  coef(
    summary(model_quadratic)
  )
)

# ------------------------------------------------------------
# 2.5.6 Type III ANOVA for quadratic model
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.6 Quadratic model Type III ANOVA\n")
cat("------------------------------------------------------------\n\n")

anova_quadratic <- anova(
  model_quadratic,
  type = 3
)

print(
  anova_quadratic
)

# ------------------------------------------------------------
# 2.5.7 Calculate stationary point
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.7 Estimated stationary point\n")
cat("------------------------------------------------------------\n\n")

beta_linear <-
  fixef(model_quadratic)[
    "Dose_t_ha"
  ]

beta_quadratic <-
  fixef(model_quadratic)[
    "I(Dose_t_ha^2)"
  ]

stationary_point <-
  -beta_linear /
  (2 * beta_quadratic)

cat(
  "Linear coefficient:",
  beta_linear,
  "\n"
)

cat(
  "Quadratic coefficient:",
  beta_quadratic,
  "\n"
)

cat(
  "Estimated stationary point:",
  stationary_point,
  "t ha-1\n"
)

# ------------------------------------------------------------
# 2.5.8 Determine whether stationary point is a maximum
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.8 Stationary-point classification\n")
cat("------------------------------------------------------------\n\n")

stationary_point_type <-
  ifelse(
    beta_quadratic < 0,
    "Maximum",
    ifelse(
      beta_quadratic > 0,
      "Minimum",
      "No quadratic curvature"
    )
  )

cat(
  "Stationary-point classification:",
  stationary_point_type,
  "\n"
)

# ------------------------------------------------------------
# 2.5.9 Check whether stationary point is inside
# experimental dose range
# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5.9 Stationary-point domain check\n")
cat("------------------------------------------------------------\n\n")

dose_min <-
  min(
    soybean_data$Dose_t_ha,
    na.rm = TRUE
  )

dose_max <-
  max(
    soybean_data$Dose_t_ha,
    na.rm = TRUE
  )

stationary_point_in_range <-
  stationary_point >= dose_min &
  stationary_point <= dose_max

cat(
  "Experimental dose range:",
  dose_min,
  "to",
  dose_max,
  "t ha-1\n"
)

cat(
  "Stationary point:",
  stationary_point,
  "t ha-1\n"
)

cat(
  "Stationary point inside experimental range:",
  stationary_point_in_range,
  "\n"
)

