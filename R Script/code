# ------------------------------------------------------------
# GENERAL FUNCTION FOR CENTERED QUADRATIC LM MODELS
# ------------------------------------------------------------

recover_lm_quadratic <- function(
    
  model,
  data,
  crop_name,
  center_value = 40
  
) {
  
  
  # ----------------------------------------------------------
  # 1. Fixed-effect coefficients
  # ----------------------------------------------------------
  
  beta <- coef(model)
  
  beta1 <-
    beta["Dose_centered"]
  
  beta2 <-
    beta["I(Dose_centered^2)"]
  
  
  # ----------------------------------------------------------
  # 2. Optimal dose — centered scale
  # ----------------------------------------------------------
  
  optimum_centered <-
    -beta1 /
    (2 * beta2)
  
  
  # ----------------------------------------------------------
  # 3. Optimal dose — original scale
  # ----------------------------------------------------------
  
  optimum_original <-
    optimum_centered +
    center_value
  
  
  # ----------------------------------------------------------
  # 4. Experimental dose range
  # ----------------------------------------------------------
  
  dose_min <-
    min(
      data$Dose_t_ha,
      na.rm = TRUE
    )
  
  dose_max <-
    max(
      data$Dose_t_ha,
      na.rm = TRUE
    )
  
  
  optimum_inside <-
    optimum_original >= dose_min &
    optimum_original <= dose_max
  
  
  # ----------------------------------------------------------
  # 5. Coefficient table
  # ----------------------------------------------------------
  
  coefficient_table <-
    coef(
      summary(model)
    )
  
  
  beta1_p <-
    coefficient_table[
      "Dose_centered",
      "Pr(>|t|)"
    ]
  
  beta1_t <-
    coefficient_table[
      "Dose_centered",
      "t value"
    ]
  
  beta1_se <-
    coefficient_table[
      "Dose_centered",
      "Std. Error"
    ]
  
  
  beta2_p <-
    coefficient_table[
      "I(Dose_centered^2)",
      "Pr(>|t|)"
    ]
  
  beta2_t <-
    coefficient_table[
      "I(Dose_centered^2)",
      "t value"
    ]
  
  beta2_se <-
    coefficient_table[
      "I(Dose_centered^2)",
      "Std. Error"
    ]
  
  
  # ----------------------------------------------------------
  # 6. Year effect
  # ----------------------------------------------------------
  
  year_row <-
    grep(
      "^Year",
      rownames(coefficient_table)
    )[1]
  
  year_effect <-
    coefficient_table[
      year_row,
      "Estimate"
    ]
  
  year_se <-
    coefficient_table[
      year_row,
      "Std. Error"
    ]
  
  year_t <-
    coefficient_table[
      year_row,
      "t value"
    ]
  
  year_p <-
    coefficient_table[
      year_row,
      "Pr(>|t|)"
    ]
  
  
  # ----------------------------------------------------------
  # 7. Prediction at optimal dose
  # ----------------------------------------------------------
  
  years <-
    levels(
      factor(
        data$Year
      )
    )
  
  
  optimum_grid <-
    expand.grid(
      Dose_t_ha = optimum_original,
      Year = years
    ) %>%
    
    mutate(
      
      Dose_centered =
        Dose_t_ha -
        center_value
      
    )
  
  
  # Exact fixed-effect structure
  X <-
    model.matrix(
      
      ~ Year +
        Dose_centered +
        I(Dose_centered^2),
      
      data =
        optimum_grid
      
    )
  
  
  beta_model <-
    coef(model)
  
  
  structure_matches <-
    identical(
      colnames(X),
      names(beta_model)
    )
  
  
  # ----------------------------------------------------------
  # 8. Predicted response
  # ----------------------------------------------------------
  
  optimum_grid$fit <-
    as.numeric(
      X %*%
        beta_model
    )
  
  
  # ----------------------------------------------------------
  # 9. Prediction standard error
  # ----------------------------------------------------------
  
  V_beta <-
    vcov(model)
  
  
  optimum_grid$SE <-
    sqrt(
      rowSums(
        (
          X %*%
            V_beta
        ) *
          X
      )
    )
  
  
  # ----------------------------------------------------------
  # 10. 95% confidence intervals
  # ----------------------------------------------------------
  
  df_model <-
    df.residual(model)
  
  t_critical <-
    qt(
      0.975,
      df = df_model
    )
  
  
  optimum_grid <-
    optimum_grid %>%
    
    mutate(
      
      lower95 =
        fit -
        t_critical * SE,
      
      upper95 =
        fit +
        t_critical * SE
      
    )
  
  
  # ----------------------------------------------------------
  # 11. Maximum predicted productivity
  # ----------------------------------------------------------
  
  maximum_prediction <-
    max(
      optimum_grid$fit
    )
  
  
  maximum_row <-
    which.max(
      optimum_grid$fit
    )
  
  
  maximum_lower95 <-
    optimum_grid$lower95[
      maximum_row
    ]
  
  
  maximum_upper95 <-
    optimum_grid$upper95[
      maximum_row
    ]
  
  
  optimum_year <-
    optimum_grid$Year[
      maximum_row
    ]
  
  
  # ----------------------------------------------------------
  # 12. Vertical displacement
  # ----------------------------------------------------------
  
  vertical_shift <-
    diff(
      optimum_grid$fit
    )
  
  
  # ----------------------------------------------------------
  # 13. Adjusted R²
  # ----------------------------------------------------------
  
  model_summary <-
    summary(model)
  
  adjusted_R2 <-
    model_summary$adj.r.squared
  
  
  # ----------------------------------------------------------
  # 14. Final recovery table
  # ----------------------------------------------------------
  
  final_summary <-
    tibble(
      
      Crop =
        crop_name,
      
      Dose_optimal_centered =
        optimum_centered,
      
      Dose_optimal_t_ha =
        optimum_original,
      
      Experimental_min_t_ha =
        dose_min,
      
      Experimental_max_t_ha =
        dose_max,
      
      Optimum_inside_range =
        optimum_inside,
      
      Beta_linear =
        beta1,
      
      SE_linear =
        beta1_se,
      
      t_linear =
        beta1_t,
      
      P_linear =
        beta1_p,
      
      Beta_quadratic =
        beta2,
      
      SE_quadratic =
        beta2_se,
      
      t_quadratic =
        beta2_t,
      
      P_quadratic =
        beta2_p,
      
      Year_effect =
        year_effect,
      
      Year_effect_SE =
        year_se,
      
      Year_effect_t =
        year_t,
      
      Year_effect_p =
        year_p,
      
      Maximum_predicted_response =
        maximum_prediction,
      
      Maximum_response_lower95 =
        maximum_lower95,
      
      Maximum_response_upper95 =
        maximum_upper95,
      
      Optimum_year =
        optimum_year,
      
      Vertical_shift =
        vertical_shift,
      
      Adjusted_R2 =
        adjusted_R2,
      
      Prediction_matrix_matches =
        structure_matches
      
    )
  
  
  # ----------------------------------------------------------
  # 15. Return both summary and prediction table
  # ----------------------------------------------------------
  
  list(
    
    summary =
      final_summary,
    
    predictions =
      optimum_grid
    
  )
  
}


