  MG      = "Exchangeable magnesium (Mg2+)",
  CA      = "Exchangeable calcium (Ca2+)",
  K       = "Exchangeable potassium (K+)",
  SB      = "Sum of bases (SB)",
  V       = "Base saturation (V%)",
  SATAL   = "Aluminum saturation (m%)",
  CTC     = "Cation exchange capacity at pH 7 (CEC)",
  CTCEFET = "Effective cation exchange capacity (ECEC)"
)


# ------------------------------------------------------------
# 4. PREPARE 3A
# ------------------------------------------------------------

anova_3A <- purrr::imap_dfr(
  
  soil_models,
  
  ~{
    
    model <- .x
    
    a <- anova(
      model,
      type = 3
    ) %>%
      as.data.frame() %>%
      tibble::rownames_to_column("Term")
    
    tibble(
      Variable = .y,
      Year_p = a$`Pr(>F)`[a$Term == "Year"],
      Dose_p = a$`Pr(>F)`[a$Term == "Dose_t_ha"],
      Depth_p = a$`Pr(>F)`[a$Term == "Depth"],
      Year_Dose_p = a$`Pr(>F)`[
        a$Term == "Year:Dose_t_ha"
      ],
      Year_Depth_p = a$`Pr(>F)`[
        a$Term == "Year:Depth"
      ],
      Dose_Depth_p = a$`Pr(>F)`[
        a$Term == "Dose_t_ha:Depth"
      ],
      Year_Dose_Depth_p = a$`Pr(>F)`[
        a$Term == "Year:Dose_t_ha:Depth"
      ]
    )
  }
)


