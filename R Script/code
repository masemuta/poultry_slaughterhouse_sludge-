extract_anova_3A <- function(
    
  model,
  
  variable
  
){
  
  
  tab <- anova(
    
    model,
    
    type = 3
    
  )
  
  
  tab <- as.data.frame(
    
    tab
    
  )
  
  
  tab$Term <- rownames(
    
    tab
    
  )
  
  
  rownames(
    
    tab
    
  ) <- NULL
  
  
  names(tab) <- make.names(
    
    names(tab)
    
  )
  
  
  F_col <- intersect(
    
    c(
      
      "F.value",
      "F_value"
      
    ),
    
    names(tab)
    
  )[1]
  
  
  p_col <- intersect(
    
    c(
      
      "Pr..F.",
      "Pr...F.",
      "p.value",
      "p_value"
      
    ),
    
    names(tab)
    
  )[1]
  
  
  numdf_col <- intersect(
    
    c(
      
      "NumDF",
      "numDF",
      "Df"
      
    ),
    
    names(tab)
    
  )[1]
  
  
  dendf_col <- intersect(
    
    c(
      
      "DenDF",
      "denDF"
      
    ),
    
    names(tab)
    
  )[1]
  
  
  if(
    
    is.na(F_col) |
    is.na(p_col)
    
  ){
    
    stop(
      
      paste(
        
        "Could not identify ANOVA columns for:",
        variable
        
      )
      
    )
    
  }
  
  
  tibble(
    
    Variable = variable,
    
    Term = tab$Term,
    
    F_value = as.numeric(
      
      tab[[F_col]]
      
    ),
    
    df_num = if(
      
      !is.na(numdf_col)
      
    ){
      
      as.numeric(
        
        tab[[numdf_col]]
        
      )
      
    } else {
      
      NA_real_
      
    },
    
    df_den = if(
      
      !is.na(dendf_col)
      
    ){
      
      as.numeric(
        
        tab[[dendf_col]]
        
      )
      
    } else {
      
      NA_real_
      
    },
    
    p_value = as.numeric(
      
      tab[[p_col]]
      
    )
    
  )
  
}


