make_coef_table <- function(
    model,
    crop
){
  
  coef <- as.data.frame(
    summary(model)$coefficients
  )
  
  coef$Term <- rownames(coef)
  
  rownames(coef) <- NULL
  
  coef %>%
    
    transmute(
      
      Crop = crop,
      
      Term,
      
      Estimate,
      
      SE = `Std. Error`,
      
      t_value = `t value`,
      
      p_value = `Pr(>|t|)`
      
    )
  
}

