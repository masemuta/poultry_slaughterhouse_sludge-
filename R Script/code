cat("------------------------------------------------------------\n\n")


get_variance_components <- function(model) {
  
  vc <- as.data.frame(
    VarCorr(model)
  )
  
  random_variance <-
    sum(
      vc$vcov[
        vc$grp != "Residual"
      ]
    )
  
  residual_variance <-
    vc$vcov[
      vc$grp == "Residual"
    ][1]
  
  total_variance <-
    random_variance +
    residual_variance
  
  tibble(
    
    Random_variance =
      random_variance,
    
    Residual_variance =
      residual_variance,
    
    ICC =
      random_variance /
      total_variance
    
  )
  
}


