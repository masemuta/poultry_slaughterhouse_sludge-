# ------------------------------------------------------------
# 4. FUNÇÃO — CONTRASTES DE PROFUNDIDADE
# ------------------------------------------------------------

depth_contrasts <- function(model, variable) {
  
  emm <- emtrends(
    model,
    ~ Year * Depth,
    var = "Dose_t_ha"
  )
  
  
  # ----------------------------------------------------------
  # Profundidades dentro de cada ano
  # ----------------------------------------------------------
  
  contrast_depth <- contrast(
    emm,
    method = "pairwise",
    by = "Year",
    adjust = "tukey"
  )
  
  
  out <- as.data.frame(
    summary(
      contrast_depth,
      infer = c(TRUE, TRUE)
    )
  )
  
  
  out %>%
    mutate(
      Variable = variable,
      Contrast_type = "Depth within Year"
    )
}


