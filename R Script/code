# ------------------------------------------------------------
# 5. FUNÇÃO DE AJUSTE
# ------------------------------------------------------------

fit_soil_model <- function(
    response,
    data
){
  
  formula_model <- as.formula(
    paste0(
      response,
      " ~ Year * Dose_t_ha * Depth + ",
      "(1 | Plot_ID)"
    )
  )
  
  model <- lmer(
    formula_model,
    data = data,
    REML = TRUE
  )
  
  return(model)
  
}

# ------------------------------------------------------------
# 6. AJUSTE DOS MODELOS
# ------------------------------------------------------------

soil_models <- list()

for(
  variable in soil_variables
){
  
  message(
    "\n===================================================="
  )
  
  message(
    "VARIABLE: ",
    variable
  )
  
  message(
    "===================================================="
  )
  
  data_variable <- dados_solo %>%
    filter(
      !is.na(
        .data[[variable]]
      )
    )
  
  model <- fit_soil_model(
    variable,
    data_variable
  )
  
  soil_models[[variable]] <- model
  
  print(
    summary(model)
  )
  
  cat("\nConvergence:\n")
  
  print(
    is.null(
      model@optinfo$conv$lme4$messages
    )
  )
  
  cat("\nSingular fit:\n")
  
  print(
    isSingular(
      model,
      tol = 1e-4
    )
  )
  
  cat("\nType III ANOVA:\n")
  
  print(
    anova(
      model,
      type = 3
    )
  )
  
}

