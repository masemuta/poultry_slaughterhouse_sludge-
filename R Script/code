      X_pred
  )
)

prediction_grid <- prediction_grid %>%
  mutate(
    
    lower =
      fit -
      qt(
        0.975,
        df = df.residual(
          model_quadratic_centered
        )
      ) *
      SE,
    
    upper =
      fit +
      qt(
        0.975,
        df = df.residual(
