  )

# ------------------------------------------------------------
# 1.2 Fixed-effect prediction matrix
# ------------------------------------------------------------

X_pred <- model.matrix(
  ~ Year +
    Dose_centered +
    I(Dose_centered^2),
  data = prediction_grid
)

beta <- fixef(
  model_quadratic_centered
)

