# ------------------------------------------------------------
# 5. ESPECIFICAÇÃO DA ESTRUTURA DE DECOMPOSIÇÃO
# ------------------------------------------------------------
#
# A estrutura abaixo foi definida a partir do Type III ANOVA
# validado no Bloco 3A.
#
# "Year_Depth":
#   slope estimado separadamente para cada combinação
#   Year × Depth.
#
# "Depth":
#   slope estimado separadamente para cada profundidade,
#   marginalizado sobre Year.
#
# "Year":
#   slope estimado separadamente para cada ano,
#   marginalizado sobre Depth.
#
# "None":
#   nenhuma decomposição de dose.
#
# ------------------------------------------------------------

trend_structure <- tribble(
  
  ~Variable,  ~Structure,     ~Reason,
  
  "MO",       "Year_Depth",   "significant Year × Dose × Depth",
  "P",        "Depth",        "significant Dose × Depth; no Year × Dose",
  "PHCACL",   "Year_Depth",   "significant Year × Dose × Depth",
  "SMP",      "Depth",        "significant Dose × Depth; no Year × Dose",
  "HAL",      "Depth",        "significant Dose × Depth; no Year × Dose",
  "AL",       "Year_Depth",   "significant Year × Dose and Dose × Depth",
  "MG",       "Year_Depth",   "significant Year × Dose and Dose × Depth",
  "CA",       "Year_Depth",   "significant Year × Dose × Depth",
  "K",        "Year_Depth",   "significant Year × Dose × Depth",
  "SB",       "Year_Depth",   "significant Year × Dose × Depth",
  "V",        "Year_Depth",   "significant Year × Dose and Dose × Depth",
  "SATAL",    "Year_Depth",   "significant Year × Dose × Depth",
  "CTC",      "None",         "no significant dose effect or dose interaction",
  "CTCEFET",  "Year",         "significant Year × Dose; no Dose × Depth"
)


# ------------------------------------------------------------
# 6. FUNÇÃO PARA EXTRAIR EM TRENDS
# ------------------------------------------------------------

extract_trends <- function(model,
                           variable,
                           structure) {
  
  if (structure == "Year_Depth") {
    
    emm <- emtrends(
      model,
      ~ Year * Depth,
      var = "Dose_t_ha"
    )
    
  } else if (structure == "Depth") {
    
    emm <- emtrends(
      model,
      ~ Depth,
      var = "Dose_t_ha"
    )
    
  } else if (structure == "Year") {
    
    emm <- emtrends(
      model,
      ~ Year,
      var = "Dose_t_ha"
    )
    
  } else {
    
    return(NULL)
  }
  
  
  out <- as.data.frame(
    summary(
      emm,
      infer = c(TRUE, TRUE)
    )
  )
  
  
  # ----------------------------------------------------------
  # Padronização
  # ----------------------------------------------------------
  
  out <- out %>%
    mutate(
      Variable = variable,
      Structure = structure,
      Dose_unit = "t ha-1"
    ) %>%
    rename(
      Slope = Dose_t_ha.trend
    )
  
  
  # ----------------------------------------------------------
  # Seleção das colunas relevantes
  # ----------------------------------------------------------
  
  desired <- c(
    "Variable",
    "Structure",
    "Year",
    "Depth",
    "Slope",
    "SE",
    "df",
    "lower.CL",
    "upper.CL",
    "t.ratio",
    "p.value",
    "Dose_unit"
  )
  
  
  desired <- intersect(
    desired,
    names(out)
  )
  
  
  out %>%
    select(all_of(desired))
}


