    x <- culturas_clean[[variable]]
    
    Q1 <- quantile(
      x,
      0.25,
      na.rm = TRUE
    )
    
    Q3 <- quantile(
      x,
      0.75,
      na.rm = TRUE
    )
    
    IQR_value <- Q3 - Q1
    
    lower <- Q1 - 1.5 * IQR_value
    upper <- Q3 + 1.5 * IQR_value
    
    tibble(
      
      Crop = variable,
      
      Q1 = Q1,
      
      Q3 = Q3,
      
      IQR = IQR_value,
      
      Lower_bound = lower,
      
      Upper_bound = upper,
      
      N_potential_outliers =
        sum(
          x < lower |
            x > upper,
          na.rm = TRUE
        )
      
    )
    
  }
)

