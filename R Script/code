# ------------------------------------------------------------

cat("\n------------------------------------------------------------\n")
cat("2.5C.2 Bootstrap function\n")
cat("------------------------------------------------------------\n\n")

bootstrap_optimum <- function(
    data,
    n_boot = 2000,
    seed = 20260827
) {
  
  set.seed(seed)
  
  plot_ids <-
    unique(
      data$Plot
    )
  
  results <-
    vector(
      "list",
      n_boot
    )
  
  for (i in seq_len(n_boot)) {
    
    sampled_plots <-
      sample(
        plot_ids,
        size = length(plot_ids),
        replace = TRUE
      )
    
    boot_data <-
      map_dfr(
        sampled_plots,
        function(p) {
          
          data %>%
            filter(
              Plot == p
            )
          
        }
      ) %>%
      mutate(
        Boot_Plot = factor(
          rep(
            seq_along(sampled_plots),
            each = 2
          )
        )
      )
    
    fit <-
      tryCatch(
        
        lmer(
          Soja ~
            Year +
            Dose_centered +
            I(Dose_centered^2) +
            (1 | Boot_Plot),
          data = boot_data,
          REML = FALSE
        ),
        
        error = function(e)
          NULL
        
      )
    
    if (is.null(fit)) {
      
      results[[i]] <-
        tibble(
          replicate = i,
          optimum = NA_real_,
          quadratic = NA_real_,
          converged = FALSE
        )
      
      next
      
    }
    
    coefficients <-
      fixef(fit)
    
    linear_beta <-
      coefficients[
        "Dose_centered"
      ]
    
    quadratic_beta <-
      coefficients[
        "I(Dose_centered^2)"
      ]
    
    optimum_centered <-
      -linear_beta /
      (2 * quadratic_beta)
    
    optimum_original <-
      optimum_centered + 40
    
    converged <-
      is.null(
        fit@optinfo$conv$lme4$messages
      )
    
    results[[i]] <-
      tibble(
        replicate = i,
        optimum = as.numeric(
          optimum_original
        ),
        quadratic = as.numeric(
          quadratic_beta
        ),
        converged = converged
      )
  }
  
  bind_rows(
    results
  )
}

