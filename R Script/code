max_prediction <- function(
    model,
    optimum,
    response_scale = 40
){
  
  newdata <- data.frame(
    
    Year = factor(
      c(
        "2019–2020",
        "2020–2021"
      ),
      levels = levels(
        model$model$Year
      )
    ),
    
    Dose_centered =
      optimum - 40
    
  )
  
  prediction <- predict(
    model,
    newdata = newdata,
    interval = "confidence",
    level = 0.95
  )
  
  bind_cols(
    newdata,
    as.data.frame(prediction)
  ) %>%
    
    mutate(
      
      Dose_t_ha = optimum,
      
      fit_kg_ha = fit * response_scale,
      lwr_kg_ha = lwr * response_scale,
      upr_kg_ha = upr * response_scale
      
    )
}

